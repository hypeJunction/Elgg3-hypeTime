# Per-plugin docker test environment.
# Copy this file to docker/.env and fill in PLUGIN_ID.

# Lowercase Elgg plugin id. Must match the plugin directory name.
PLUGIN_ID=hypetime

# Optional: override host-side ports if the defaults clash with another stack.
# ELGG_PORT=9603
# DB_PORT=10603

# Optional: override hypepost source dir (default: sibling directory ../../hypepost)
# HYPEPOST_DIR=/absolute/path/to/hypepost
